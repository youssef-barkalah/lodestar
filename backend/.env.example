# Lodestar backend configuration
#
# Copy this file to `.env` and adjust if needed.
# The defaults below work for local development, so a `.env` is optional.

# Port the Lodestar backend API listens on.
PORT=3001

# URL of the SearXNG instance.
SEARXNG_URL=http://localhost:8080

# Allowed frontend origin for CORS (set to * to allow any origin in development).
CORS_ORIGIN=http://localhost:3000

# Maximum query length in characters.
MAX_QUERY_LENGTH=200

# SearXNG request timeout in milliseconds.
SEARCH_TIMEOUT=20000

# Supabase (accounts + synced search data).
# Get these from Supabase: Project Settings -> API.
# The service role key is required. It stays secret on this machine and is
# used by the backend to manage the users and user_sync tables.
# After adding it, run backend/data/supabase-schema.sql in your project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
